<?xml version="1.0" encoding="UTF-8"?>

<mod:findName type="event" name="START_BEACON_REAL" limit="1">
	<mod-append:queueEvent>INITIAL_START_BEACON_IRON_CURTAIN_LOAD</mod-append:queueEvent>
</mod:findName>

<event name="INITIAL_START_BEACON_IRON_CURTAIN_LOAD">
	<loadEventList seeded="false" first="true" generate="false" default="INITIAL_START_BEACON_IRON_CURTAIN_CANCEL">
		<event name="INITIAL_START_BEACON_IRON_CURTAIN" req="IRON_CURTAIN" lvl="1"/>
	</loadEventList>
</event>
<event name="INITIAL_START_BEACON_IRON_CURTAIN_CANCEL"/>

<event name="INITIAL_START_BEACON_IRON_CURTAIN">
    <text>Your ship is equipped with an Iron Curtain. When charged, it can be used by pressing the UI button or the hotkey assigned to it (tilde by default). You can configure its hotkey and automation through the toggle menu.</text>
    <choice hidden="true">
        <text>Continue...</text>
        <event load="INITIAL_START_BEACON_IRON_CURTAIN_CANCEL"/>
    </choice>
    <eventButton name="UI_IRON_CURTAIN">
        <event load="LUA_IRON_CURTAIN"/>
        <image>statusUI/iron_curtain</image>
        <customLocation x="98" y="82"/>
        <tooltip>Activate the Iron Curtain.</tooltip>
        <inactiveTooltip>Iron Curtain not charged.</inactiveTooltip>
        <req>loc_iron_curtain_charged</req>
        <jumpClear>false</jumpClear>
    </eventButton>
</event>
